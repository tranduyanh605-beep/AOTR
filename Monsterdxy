-- Monsterdxy - AOT:R | Expanded UI, Lobby Tab & Auto-Save Config
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- KONFIGURATIONS-SYSTEM (Speichert Einstellungen automatisch)
local folderName = "Monsterdxy_AOTR"
local fileName = "Monsterdxy_AOTR/config.json"

local config = {
    AutoA = false,
    AutoB = false,
    AutoC = false,
    AutoQueue = false,
    AutoReady = false,
    SafeMode = false
}

local function saveConfig()
    pcall(function()
        if not isfolder(folderName) then makefolder(folderName) end
        writefile(fileName, HttpService:JSONEncode(config))
    end)
end

local function loadConfig()
    pcall(function()
        if isfile(fileName) then
            local decoded = HttpService:JSONDecode(readfile(fileName))
            for k, v in pairs(decoded) do
                config[k] = v
            end
        end
    end)
end

loadConfig()

