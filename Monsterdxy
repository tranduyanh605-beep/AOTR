-- Monster | AOTR Secure Core
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Exakter AOTR Place-ID Check (13379208636)
local AOTR_ID = 13379208636

if game.PlaceId ~= AOTR_ID then
    LocalPlayer:Kick("\n[Monster Security]\nFalsches Spiel! Dieses Skript läuft NUR in Attack on Titan: Revolution (AOTR).")
    return
end

-- Altes UI entfernen falls vorhanden
if game.CoreGui:FindFirstChild("MonsterAOTR_UI") then
    game.CoreGui.MonsterAOTR_UI:Destroy()
end

-- Neues Custom UI erstellen
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MonsterAOTR_UI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0.5, -140, 0.5, -175)
MainFrame.Size = UDim2.new(0, 280, 0, 350)

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 10)
MainCorner.Parent = MainFrame

local TitleBar = Instance.new("Frame")
TitleBar.Parent = MainFrame
TitleBar.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
TitleBar.BorderSizePixel = 0
TitleBar.Size = UDim2.new(1, 0, 0, 45)

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = TitleBar

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Parent = TitleBar
TitleLabel.BackgroundTransparency = 1
TitleLabel.Position = UDim2.new(0, 15, 0, 0)
TitleLabel.Size = UDim2.new(1, -15, 1, 0)
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Text = "MONSTER | AOTR ULTIMATE"
TitleLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
TitleLabel.TextSize = 13
TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

-- Menü mit Right Shift ein-/ausblenden
local uiVisible = true
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift then
        uiVisible = not uiVisible
        MainFrame.Visible = uiVisible
    end
end)

print("[Monster] AOTR erfolgreich erkannt und UI geladen!")
