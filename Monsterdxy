local pages = {}
local function createPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Parent = ContentHolder
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 0, 200)
    page.ScrollBarThickness = 3
    pages[name] = page
    return page
end

local mainMenuPage = createPage("Main Menu")
local settingsPage = createPage("Settings")

local tabButtons = {}
local function createTabButton(name, yPos, targetPage)
    local btn = Instance.new("TextButton")
    btn.Parent = Sidebar
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.Size = UDim2.new(1, -16, 0, 32)
    btn.AutoButtonColor = false
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(180, 180, 190)
    btn.TextSize = 12

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        for _, b in pairs(tabButtons) do 
            b.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            b.TextColor3 = Color3.fromRGB(180, 180, 190) 
        end
        targetPage.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    table.insert(tabButtons, btn)
    return btn
end

