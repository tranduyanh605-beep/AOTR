-- Modern UI TriggerBot (Optimized for AOTR)
-- Notice: Absolute protection against bans is technically impossible due to client-side execution.

local Success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not Success or not Rayfield then
    warn("Failed to load Rayfield UI library.")
    return
end

local Window = Rayfield:CreateWindow({
    Name = "Monster | AOTR Advanced",
    LoadingTitle = "Initializing Secure Environment...",
    LoadingSubtitle = "By Monster",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "MonsterConfigAOTR",
        FileName = "Settings"
    }
})

local MainTab = Window:CreateTab("Combat", 4483362458)
local Section = MainTab:CreateSection("TriggerBot Settings")

-- Variablen
local triggerEnabled = false
local m1TriggerEnabled = false
local isProcessing = false

-- Dienste
local vim = game:GetService("VirtualInputManager")
local runService = game:GetService("RunService")
local players = game:GetService("Players")
local userInput = game:GetService("UserInputService")
local localPlayer = players.LocalPlayer
local mouse = localPlayer:GetMouse()

local loopConnection = nil

-- Zuverlässigere und sauberere Trigger-Logik
local function checkTrigger()
    if (not triggerEnabled and not m1TriggerEnabled) or isProcessing then return end
    
    local target = mouse.Target
    if target and target.Parent then
        local character = target.Parent
        local player = players:GetPlayerFromCharacter(character)
        
        -- Überprüft, ob es sich um einen gültigen, lebenden Spieler handelt
        if player and player ~= localPlayer then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                isProcessing = true
                
                -- Zufällige minimale Verzögerung simuliert menschliches Verhalten (schützt vor automatischen Bans)
                task.wait(math.random(10, 30) / 1000)
                
                if triggerEnabled then
                    vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    task.wait(0.01)
                    vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                end
                
                if m1TriggerEnabled then
                    local mouseLoc = userInput:GetMouseLocation()
                    vim:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 0, true, game, 0)
                    task.wait(0.01)
                    vim:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 0, false, game, 0)
                end
                
                task.wait(0.08) -- Debounce, um Spam zu verhindern
                isProcessing = false
            end
        end
    end
end

local function updateLoop()
    if triggerEnabled or m1TriggerEnabled then
        if not loopConnection then
            -- Nutzen von Heartbeat für stabilere Ausführung
            loopConnection = runService.Heartbeat:Connect(checkTrigger)
        end
    else
        if loopConnection then
            loopConnection:Disconnect()
            loopConnection = nil
        end
        isProcessing = false
    end
end

-- UI Elemente (Neues Design)
MainTab:CreateToggle({
    Name = "R-Key TriggerBot",
    CurrentValue = false,
    Flag = "RKeyToggle",
    Callback = function(Value)
        triggerEnabled = Value
        updateLoop()
        if Value then
            Rayfield:Notify({
                Title = "Module Active",
                Content = "R-Key TriggerBot enabled.",
                Duration = 2,
                Image = 4483362458
            })
        end
    end,
})

MainTab:CreateToggle({
    Name = "M1 (Click) TriggerBot",
    CurrentValue = false,
    Flag = "M1Toggle",
    Callback = function(Value)
        m1TriggerEnabled = Value
        updateLoop()
        if Value then
            Rayfield:Notify({
                Title = "Module Active",
                Content = "M1 TriggerBot enabled.",
                Duration = 2,
                Image = 4483362458
            })
        end
    end,
})

Rayfield:LoadConfiguration()
